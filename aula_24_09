#EXEMPLO 1

t = -10:0.01 : 10; #começa em -10, vai até 10 incrementando 0,01
T = 6
omega = 2*pi/T;
T1 = 2;
x =  2*T1/T #valor inciaal, meu a0
N= 10000

#for generalizando a função e tendendo ela a N
for k = 1:N
  x= x+((sin(k*omega*T1))/pi/k)*exp(j*k*omega*t);
end
  plot(t,x)

